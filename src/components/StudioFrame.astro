---
import SiteLayout from '../layouts/SiteLayout.astro';

interface Props {
  title: string;
  description?: string;
  area?: 'member' | 'admin';
  wide?: boolean;
}

const { title, description = '会员专属的私密相册家谱。', area = 'member', wide = false } = Astro.props;
const isAdmin = area === 'admin';
const backHref = isAdmin ? '/' : '/studio';
const backLabel = isAdmin ? '← 返回网站首页' : '← 我的相册家谱';
---
<SiteLayout lang="zh" title={title} description={description} robots="noindex, nofollow" alternate={false}>
  <section class:list={['studio-shell', { 'studio-shell-admin': isAdmin, 'studio-shell-wide': wide }]}>
    {!isAdmin && <section class="studio-policy-gate" data-studio-policy-gate hidden aria-labelledby="studio-policy-title">
      <div class="studio-policy-gate-card">
        <span class="eyebrow">MEMBER AGREEMENT / 会员确认</span>
        <h2 id="studio-policy-title">进入会员谱坊前，请先阅读并同意</h2>
        <p>会员谱坊用于整理和暂存相册家谱资料。家谱默认私密；公开章节必须另行申请并经学会审核。</p>
        <p><a href="/privacy" target="_blank" rel="noreferrer">阅读隐私政策 ↗</a><span aria-hidden="true">　</span><a href="/terms" target="_blank" rel="noreferrer">阅读会员使用条款 ↗</a></p>
        <label class="studio-policy-consent"><input type="checkbox" data-policy-consent /> 我已阅读并同意隐私政策和会员使用条款，并确认我有权提交所填写的家人资料。</label>
        <div class="studio-policy-actions"><button class="button" type="button" data-policy-accept disabled>同意并继续</button><button class="text-link" type="button" data-policy-signout>退出会员谱坊</button></div>
        <p class="studio-status" aria-live="polite" data-policy-status></p>
      </div>
    </section>}
    <div class="studio-topline">
      <a class="studio-back-link" href={backHref}>{backLabel}</a>
      <button class="studio-signout" type="button" data-studio-signout hidden>{isAdmin ? '退出管理员页面' : '退出谱坊'}</button>
    </div>
    <div class="studio-heading">
      <span class="eyebrow">{isAdmin ? 'ROOTS CULTURE SOCIETY / 管理员后台' : 'MEMBER STUDIO / 会员谱坊'}</span>
      <h1 data-studio-page-title>{title}</h1>
    </div>
    <slot />
  </section>
</SiteLayout>
