---
import SiteLayout from '../layouts/SiteLayout.astro';

interface Props {
  title: string;
  description?: string;
  area?: 'member' | 'admin';
}

const { title, description = '会员专属的私密相册家谱。', area = 'member' } = Astro.props;
const isAdmin = area === 'admin';
const backHref = isAdmin ? '/' : '/studio';
const backLabel = isAdmin ? '← 返回网站首页' : '← 我的相册家谱';
---
<SiteLayout lang="zh" title={title} description={description} robots="noindex, nofollow" alternate={false}>
  <section class:list={['studio-shell', { 'studio-shell-admin': isAdmin }]}>
    <div class="studio-topline">
      <a class="studio-back-link" href={backHref}>{backLabel}</a>
      <button class="studio-signout" type="button" data-studio-signout hidden>{isAdmin ? '退出管理员页面' : '退出谱坊'}</button>
    </div>
    <div class="studio-heading">
      <span class="eyebrow">{isAdmin ? 'ROOTS CULTURE SOCIETY / 管理员后台' : 'MEMBER STUDIO / 会员谱坊'}</span>
      <h1>{title}</h1>
    </div>
    <slot />
  </section>
</SiteLayout>
