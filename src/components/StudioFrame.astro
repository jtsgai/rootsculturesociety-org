---
import SiteLayout from '../layouts/SiteLayout.astro';
interface Props { title: string; description?: string; }
const { title, description = '会员专属的私密相册家谱。' } = Astro.props;
---
<SiteLayout lang="zh" title={title} description={description} robots="noindex, nofollow" alternate={false}>
  <section class="studio-shell">
    <div class="studio-topline"><a href="/membership">← 回到入会说明</a><button class="studio-signout" type="button" data-studio-signout hidden>退出谱坊</button></div>
    <div class="studio-heading"><span class="eyebrow">MEMBER STUDIO / 会员谱坊</span><h1>{title}</h1></div>
    <slot />
  </section>
</SiteLayout>
