---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from './PageIntro.astro';
import { activityMoments, activityRecords, articles, committee, memberMeetingRecords, methods, pageCopy, publications, stories, type Lang, type PageKey } from '../data/site';
interface Props { lang: Lang; pageKey: PageKey; }
const { lang, pageKey } = Astro.props;
const content = pageCopy[pageKey][lang];
const isZh = lang === 'zh';
const sentences = (text: string) => text.split(/(?<=[。.!?])\s*/u).filter(Boolean);
const eyebrow = isZh ? '新加坡根缘文化学会' : 'Roots Culture Society of Singapore';
const studioEnabled = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY);
---
<SiteLayout lang={lang} title={content.title} description={content.deck}>
  <PageIntro eyebrow={eyebrow} title={content.title} deck={content.deck} />
  <div class="page-body">
    <div class="prose-column">{content.paragraphs.map((p: string) => <p>{sentences(p).map((sentence) => <span class="sentence-line">{sentence}</span>)}</p>)}</div>

    {pageKey === 'committee' && <section class="committee-orgchart" aria-label={isZh ? '执委会组织结构' : 'Committee structure'}><div class="committee-level committee-lead"><article class="committee-node"><img class="committee-photo" src={committee[0].image} alt={isZh ? committee[0].altZh : committee[0].altEn} loading="lazy" /><span class="person-role">{isZh ? committee[0].roleZh : committee[0].roleEn}</span><h2>{isZh ? committee[0].zh : committee[0].en}</h2></article></div><div class="committee-level committee-deputy"><article class="committee-node"><img class="committee-photo" src={committee[1].image} alt={isZh ? committee[1].altZh : committee[1].altEn} loading="lazy" /><span class="person-role">{isZh ? committee[1].roleZh : committee[1].roleEn}</span><h2>{isZh ? committee[1].zh : committee[1].en}</h2></article></div><div class="committee-level committee-members">{committee.slice(2).map((person) => <article class="committee-node"><img class="committee-photo" src={person.image} alt={isZh ? person.altZh : person.altEn} loading="lazy" /><span class="person-role">{isZh ? person.roleZh : person.roleEn}</span><h2>{isZh ? person.zh : person.en}</h2></article>)}</div></section>}

    {pageKey === 'method' && <section class="method-grid">{methods.map((method) => <article class="method-card"><span class="method-number">{method.number}</span><h2>{isZh ? method.zh : method.en}</h2><p>{isZh ? method.zhText : method.enText}</p></article>)}</section>}

    {pageKey === 'publications' && <section class="publication-list">{publications.map((publication) => <article><img class="book-cover" src={publication.image} alt={isZh ? publication.altZh : publication.altEn} /><div><span class="year">{publication.year}</span><h2>{isZh ? publication.titleZh : publication.titleEn}</h2><p>{isZh ? publication.descriptionZh : publication.descriptionEn}</p><a class="inline-download" href={`/articles/${publication.relatedFile}`} download>{isZh ? publication.relatedZh : publication.relatedEn} <span>↗</span></a></div></article>)}</section>}
    {pageKey === 'publications' && <section class="article-downloads"><div class="section-kicker"><span class="eyebrow">ARTICLES / 文章</span><h2>{isZh ? '把资料留在手边。' : 'Keep the source material close.'}</h2><p>{isZh ? '以下文章与样本由学会资料提供，点击即可下载原 PDF。' : 'These articles and samples come from Society materials. Select a title to download the original PDF.'}</p></div><div class="article-list">{articles.map((article) => <a href={`/articles/${article.file}`} download><span><strong>{isZh ? article.zh : article.en}</strong><small>{isZh ? article.zhDescription : article.enDescription}</small></span><em>PDF ↗</em></a>)}</div></section>}

    {pageKey === 'stories' && <section class="story-grid">{stories.map((story) => <article class="story-card"><img src={story.image} alt={isZh ? story.altZh : story.altEn} loading="lazy" /><div class="story-card-body"><span class="eyebrow">{isZh ? story.bylineZh : story.bylineEn}</span><h2>{isZh ? story.titleZh : story.titleEn}</h2><p>{isZh ? story.textZh : story.textEn}</p><a class="inline-download" href={`/articles/${story.sourceFile}`} download>{isZh ? '阅读原始资料' : 'Read the source material'} <span>↗</span></a></div></article>)}</section>}

    {pageKey === 'membership' && <><section class="contact-card"><div><span class="eyebrow">{isZh ? 'MEMBERSHIP / 会员' : 'MEMBERSHIP'}</span><h2>{isZh ? '请 WhatsApp 秘书长办理入会' : 'Please WhatsApp the Secretary to join'}</h2><p>{isZh ? 'WhatsApp 秘书长：9272 8933' : 'WhatsApp the Secretary: 9272 8933'}</p></div><a class="button" href="https://wa.me/6592728933">WhatsApp 9272 8933 ↗</a></section>{studioEnabled && <section class="member-login-card"><div><span class="eyebrow">{isZh ? 'MEMBER ACCESS / 会员入口' : 'MEMBER ACCESS'}</span><h2>{isZh ? '进入我的相册家谱' : 'Enter my Photo Genealogy'}</h2><p>{isZh ? '请使用学会发出的会员号和初始密码登录。首次进入后，系统会提示你设置自己的密码。' : 'Sign in with the member ID and initial password issued by the Society. On your first visit, you will be asked to set your own password.'}</p></div><a class="button" href="/studio/login">{isZh ? '会员登录' : 'Member login'} <span>→</span></a></section>}</>}

    {pageKey === 'contact' && <section class="contact-card"><div><span class="eyebrow">{isZh ? 'SECRETARY / 秘书长' : 'SECRETARY'}</span><h2>{isZh ? '锺骏源' : 'Ian Chung'}</h2><p>WhatsApp 9272 8933<br /><a href="mailto:ianchungcy@gmail.com">ianchungcy@gmail.com</a><br />95 Jalan Lokam, Singapore 537915</p></div><a class="button" href="mailto:ianchungcy@gmail.com">{isZh ? '写信给秘书长' : 'Email the Secretary'} ↗</a></section>}

    {pageKey === 'events' && <><section class="activity-gallery">{activityMoments.map((moment) => <figure><img src={moment.image} alt={isZh ? moment.zh : moment.en} loading="lazy" /><figcaption>{isZh ? moment.zh : moment.en}</figcaption></figure>)}</section><section class="activity-records"><div class="section-kicker"><span class="eyebrow">RECORDS / 资料记录</span><h2>{isZh ? '从过往资料，认识一条持续的文化工作线索。' : 'A continuing line of cultural work, seen through the records.'}</h2></div><div class="activity-record-list">{activityRecords.map((record) => <article><div class="activity-record-year">{record.year}</div><div><h2>{isZh ? record.zh : record.en}</h2><p>{isZh ? record.zhText : record.enText}</p><a class="inline-download" href={`/articles/${record.sourceFile}`} download>{isZh ? '查看来源资料' : 'View source material'} <span>↗</span></a></div></article>)}</div></section><section class="activity-records member-meeting-records"><div class="section-kicker"><span class="eyebrow">MEMBERS’ MEETING / 会员大会</span><h2>{isZh ? '从会员大会报告整理出的活动年表。' : 'An activity timeline organised from the members’ meeting report.'}</h2><p>{isZh ? '下列内容按原始 PPTX 的日期、讲题和活动记录整理；它不是最新活动公告。' : 'The timeline follows the dates, topics and activity notes in the original PPTX; it is not a current programme announcement.'}</p></div><div class="activity-record-list">{memberMeetingRecords.map((record) => <article><div class="activity-record-year">{record.year}</div><div><h2>{isZh ? record.zh : record.en}</h2><p>{isZh ? record.zhText : record.enText}</p></div></article>)}</div><a class="inline-download" href="/events/roots-culture-member-meeting-activity-report.pptx" download>{isZh ? '下载原始会员大会活动报告（PPTX）' : 'Download the original members’ meeting activity report (PPTX)'} <span>↗</span></a></section></>}

  </div>
</SiteLayout>
