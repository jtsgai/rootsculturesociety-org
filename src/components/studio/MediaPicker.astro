---
import { getStudioMediaProfile } from '../../data/studio';

interface Props {
  method: number;
  label?: string;
  hint?: string;
  multiple?: boolean;
}
const { method, label = '图片资料', hint = '图片仅用于你的相册家谱。', multiple = true } = Astro.props;
const profile = getStudioMediaProfile(method);
---
<section class="studio-media-picker" data-media-picker data-media-method={method} data-media-profile={profile.key}>
  <div class="studio-media-heading">
    <div>
      <span class="eyebrow">PRIVATE IMAGES / 私密图片</span>
      <h3>{label}</h3>
      <p>{hint} {profile.guidance} 系统会自动校正方向并压缩展示图。</p>
    </div>
    <label class="media-upload-button">
      <span>选择图片</span>
      <input data-media-input type="file" accept="image/jpeg,image/png,image/webp" multiple={multiple} />
    </label>
  </div>
  <p class="studio-media-status" data-media-status aria-live="polite"></p>
  <div class="studio-media-list" data-media-list>
    <p class="studio-empty">尚未上传图片。</p>
  </div>
</section>
