---
interface Props { eyebrow: string; title: string; deck: string; }
const { eyebrow, title, deck } = Astro.props;
const isChinese = /[\u3400-\u9fff]/.test(deck);
const deckLines = isChinese ? deck.split('，') : [deck];
---
<section class="page-intro"><div class="eyebrow">{eyebrow}</div><h1>{title}</h1>{deck && <p class:list={['deck', { 'deck-zh': isChinese }]}>{deckLines.map((line, index) => <span>{line}{isChinese && index < deckLines.length - 1 ? '，' : ''}</span>)}</p>}</section>
