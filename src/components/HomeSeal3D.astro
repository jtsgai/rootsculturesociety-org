---
interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<div class="home-seal-stage" data-home-seal-3d>
  <img class="home-seal-fallback" src="/brand/RCSSLogo.png" alt={alt} />
  <canvas class="home-seal-canvas" aria-hidden="true" hidden></canvas>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('[data-home-seal-3d]');
  const canvas = stage?.querySelector<HTMLCanvasElement>('.home-seal-canvas');
  const fallback = stage?.querySelector<HTMLImageElement>('.home-seal-fallback');
  const isMobile = window.matchMedia('(max-width: 767px)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && canvas && fallback && !isMobile && !prefersReducedMotion) {
    const gl = canvas.getContext('webgl', { alpha: true, antialias: true, powerPreference: 'low-power' });

    if (gl) {
      const vertexSource = `
        attribute vec3 aPosition;
        attribute vec2 aUv;
        uniform float uAngle;
        uniform float uTilt;
        varying vec2 vUv;
        void main() {
          float c = cos(uAngle);
          float s = sin(uAngle);
          vec3 rotated = vec3(aPosition.x * c + aPosition.z * s, aPosition.y, -aPosition.x * s + aPosition.z * c);
          float ct = cos(uTilt);
          float st = sin(uTilt);
          rotated = vec3(rotated.x, rotated.y * ct - rotated.z * st, rotated.y * st + rotated.z * ct);
          float perspective = 3.6 / (3.6 - rotated.z);
          gl_Position = vec4(rotated.xy * perspective * 0.94, 0.0, 1.0);
          vUv = aUv;
        }
      `;
      const fragmentSource = `
        precision mediump float;
        uniform sampler2D uTexture;
        varying vec2 vUv;
        void main() {
          gl_FragColor = texture2D(uTexture, vUv);
        }
      `;

      const compile = (type: number, source: string) => {
        const shader = gl.createShader(type);
        if (!shader) throw new Error('shader');
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error('shader compile');
        return shader;
      };

      try {
        const program = gl.createProgram();
        if (!program) throw new Error('program');
        gl.attachShader(program, compile(gl.VERTEX_SHADER, vertexSource));
        gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragmentSource));
        gl.linkProgram(program);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error('program link');
        gl.useProgram(program);

        const vertices = new Float32Array([
          -1, -1, 0, 0, 0,
          1, -1, 0, 1, 0,
          1, 1, 0, 1, 1,
          -1, 1, 0, 0, 1,
        ]);
        const indices = new Uint16Array([0, 1, 2, 0, 2, 3]);
        const vertexBuffer = gl.createBuffer();
        const indexBuffer = gl.createBuffer();
        const position = gl.getAttribLocation(program, 'aPosition');
        const uv = gl.getAttribLocation(program, 'aUv');
        const angle = gl.getUniformLocation(program, 'uAngle');
        const tilt = gl.getUniformLocation(program, 'uTilt');
        const textureUniform = gl.getUniformLocation(program, 'uTexture');
        if (!vertexBuffer || !indexBuffer || position < 0 || uv < 0 || !angle || !tilt || !textureUniform) throw new Error('buffer');

        gl.bindBuffer(gl.ARRAY_BUFFER, vertexBuffer);
        gl.bufferData(gl.ARRAY_BUFFER, vertices, gl.STATIC_DRAW);
        gl.enableVertexAttribArray(position);
        gl.vertexAttribPointer(position, 3, gl.FLOAT, false, 20, 0);
        gl.enableVertexAttribArray(uv);
        gl.vertexAttribPointer(uv, 2, gl.FLOAT, false, 20, 12);
        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
        gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, indices, gl.STATIC_DRAW);
        gl.enable(gl.BLEND);
        gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

        const texture = gl.createTexture();
        const image = new Image();
        if (!texture) throw new Error('texture');
        image.onload = () => {
          gl.bindTexture(gl.TEXTURE_2D, texture);
          gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, 1);
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          gl.uniform1i(textureUniform, 0);
          fallback.hidden = true;
          canvas.hidden = false;

          const resize = () => {
            const size = Math.min(stage.clientWidth, stage.clientHeight);
            const pixelRatio = Math.min(window.devicePixelRatio, 1.5);
            canvas.width = Math.max(1, Math.round(size * pixelRatio));
            canvas.height = Math.max(1, Math.round(size * pixelRatio));
            gl.viewport(0, 0, canvas.width, canvas.height);
          };
          const render = (time: number) => {
            const seconds = time * 0.001;
            resize();
            gl.clearColor(0, 0, 0, 0);
            gl.clear(gl.COLOR_BUFFER_BIT);
            gl.uniform1f(angle, seconds * 0.12);
            gl.uniform1f(tilt, Math.sin(seconds * 0.28) * 0.045);
            gl.drawElements(gl.TRIANGLES, indices.length, gl.UNSIGNED_SHORT, 0);
            window.requestAnimationFrame(render);
          };
          window.addEventListener('resize', resize, { passive: true });
          window.requestAnimationFrame(render);
        };
        image.onerror = () => { canvas.hidden = true; };
        image.src = '/brand/RCSSLogo.png';
      } catch {
        canvas.hidden = true;
      }
    }
  }
</script>
