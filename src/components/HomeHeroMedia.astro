---
const baseImage = '/generated/roots-hero-03.jpg';
const revealImage = '/generated/roots-hero-01.jpg';
---

<div class="home-hero-media" data-hero-gallery aria-hidden="true">
  <img src={baseImage} alt="" class="home-hero-still home-hero-base" />
  <img alt="" class="home-hero-still home-hero-reveal" data-src={revealImage} />
</div>

<script>
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const gallery = hero?.querySelector('[data-hero-gallery]');
  const reveal = gallery?.querySelector('.home-hero-reveal');
  const pointerMedia = window.matchMedia('(hover: hover) and (pointer: fine)');
  const motionMedia = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (hero && reveal && pointerMedia.matches && motionMedia.matches) {
    const source = reveal.getAttribute('data-src');
    if (source) reveal.setAttribute('src', source);

    let currentX = 50;
    let currentY = 50;
    let targetX = 50;
    let targetY = 50;
    let currentOpacity = 0;
    let targetOpacity = 0;

    const render = () => {
      currentX += (targetX - currentX) * 0.22;
      currentY += (targetY - currentY) * 0.22;
      currentOpacity += (targetOpacity - currentOpacity) * 0.22;
      hero.style.setProperty('--hero-spot-x', `${currentX}%`);
      hero.style.setProperty('--hero-spot-y', `${currentY}%`);
      hero.style.setProperty('--hero-reveal-opacity', String(currentOpacity));
      window.requestAnimationFrame(render);
    };

    hero.addEventListener('pointermove', (event: PointerEvent) => {
      const rect = hero.getBoundingClientRect();
      targetX = ((event.clientX - rect.left) / rect.width) * 100;
      targetY = ((event.clientY - rect.top) / rect.height) * 100;
      targetOpacity = 1;
    });
    hero.addEventListener('pointerleave', () => { targetOpacity = 0; });
    render();
  }
</script>
