---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeSeal3D from '../components/HomeSeal3D.astro';

const featurePoints = [
  { number: '01', title: '新加坡谱式', text: '不混算中国祖谱世代，从迁入新加坡并落地生根的第一代起算。' },
  { number: '02', title: '八大招', text: '封面、姓氏渊源、祖辈迁徙、籍贯文化、世系、童年、家肴、族人资料。' },
  { number: '03', title: '活着的谱', text: '保存在会员谱坊，五至七年可再修；印刷成书为另项服务。' },
];
---
<SiteLayout lang="zh" title="首页" description="新加坡根缘文化学会">
  <section class="home-hero"><div class="hero-copy"><div class="eyebrow">以新加坡人，建修新加坡谱式。</div><h1>源在祖籍，<em>根在狮城。</em></h1><p>新加坡根缘文化学会推广通俗、易懂、易查的「相册家谱」，助家庭以南来落地的第一世为开族始点，记下自己的开族史。</p><div class="hero-actions"><a class="button" href="/membership">请 WhatsApp 秘书长办理入会</a><a class="text-link" href="/method">认识八大招 <span>↗</span></a></div></div><div class="hero-aside"><HomeSeal3D alt="新加坡根缘文化学会标志" /></div></section>
  <section class="home-section"><div class="section-heading"><span class="eyebrow">THREE STARTING POINTS</span><h2>一本活着的家谱，<br />从这里开始。</h2></div><div class="feature-grid">{featurePoints.map((point) => <article class="feature-card"><span class="method-number">{point.number}</span><h3>{point.title}</h3><p>{point.text}</p></article>)}</div></section>
  <section class="home-band"><div><span class="eyebrow">MEMBERSHIP / 会籍</span><h2>年费 S$99，<br />一年谱坊账号一个。</h2></div><div><p>交费后由学会开通会员号（R1001 起）。网站不收款。</p><a class="text-link" href="/membership">了解入会方式 <span>↗</span></a></div></section>
  <section class="home-section publication-feature"><div class="section-heading"><span class="eyebrow">PUBLICATIONS / 出版</span><h2>把记忆留下来，<br />也把路径交给后来人。</h2></div><div class="publication-stack"><div><img class="home-cover" src="/publications/chuan-deng-2025.jpeg" alt="《传灯》书封" /><span class="year">2025</span><h3>《传灯》</h3><p>与新加坡海南会馆、琼州天后宫联合出版。</p></div><div><img class="home-cover" src="/publications/photo-genealogy-2026.jpeg" alt="《相册家谱》书封" /><span class="year">2026</span><h3>《相册家谱》</h3><p>学会出版。</p></div></div></section>
  <section class="home-band pathways"><div><span class="eyebrow">ROOTS PATHWAYS / 寻根路径</span><h2>从公共资料，<br />继续往根里走。</h2></div><div><p>国家文物局 Roots · 国家档案馆 · 国家图书馆 · 华族文化中心 · 宗乡总会</p><a class="text-link" href="/links">打开寻根路径 <span>↗</span></a></div></section>
</SiteLayout>
