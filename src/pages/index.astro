---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHeroMedia from '../components/HomeHeroMedia.astro';
import HomeHeroAudio from '../components/HomeHeroAudio.astro';
import { resources } from '../data/site';

const featurePoints = [
  { number: '01', title: '新加坡谱式', text: '不混算中国祖谱世代，从迁入新加坡并落地生根的第一代起算。' },
  { number: '02', title: '八大招', text: '封面、姓氏渊源、祖辈迁徙、籍贯文化、世系、童年、家肴、族人资料。' },
  { number: '03', title: '活着的谱', text: '保存在会员谱坊，五至七年可再修；印刷成书为另项服务。' },
];
---
<SiteLayout lang="zh" title="首页" description="新加坡根缘文化学会">
  <section class="home-hero"><HomeHeroMedia /><div class="hero-copy"><div class="eyebrow">以新加坡人，建修新加坡谱式。</div><h1><span class="hero-title-line">源在祖籍，</span><br /><span class="hero-title-line"><em>根在狮城。</em></span></h1><p>新加坡根缘文化学会推广通俗、易懂、易查的「相册家谱」，<br />助家庭以南来落地的第一世为开族始点，记下自己的开族史。</p><div class="hero-actions"><a class="button" href="/membership">了解入会方式</a><a class="text-link" href="/method">认识八大招 <span>↗</span></a></div></div><HomeHeroAudio lang="zh" /><a class="hero-scroll-cue" href="#home-next" aria-label="向下浏览"><span class="hero-scroll-line"></span><span>向下浏览</span><span class="hero-scroll-arrow" aria-hidden="true">↓</span></a></section>
  <section id="home-next" class="home-section"><div class="section-heading"><span class="eyebrow">THREE STARTING POINTS</span><h2>一本活着的家谱，<br />从这里开始。</h2></div><div class="feature-grid">{featurePoints.map((point) => <article class="feature-card"><span class="method-number">{point.number}</span><h3>{point.title}</h3><p>{point.text}</p></article>)}</div></section>
  <section class="home-section publication-feature"><div class="section-heading"><span class="eyebrow">PUBLICATIONS / 出版</span><h2><span class="publication-title-line">把记忆留下来，</span><span class="publication-title-line">也把路径交给后来人。</span></h2></div><div class="publication-stack"><article class="publication-card"><img class="home-cover" src="/publications/chuan-deng-2025-book.jpg" alt="《传灯》书本展示" /><div class="publication-meta"><span class="year">2025</span><span>联合出版</span></div><h3>《传灯》</h3><p>与新加坡海南会馆、琼州天后宫联合出版。</p></article><article class="publication-card"><img class="home-cover" src="/publications/photo-genealogy-2026-book.jpg" alt="《相册家谱》书本展示" /><div class="publication-meta"><span class="year">2026</span><span>学会出版</span></div><h3>《相册家谱》</h3><p>把家族记忆整理成可阅读、可传承的相册家谱。</p></article></div></section>
  <section class="home-band pathways"><div class="pathway-copy"><span class="eyebrow">ROOTS PATHWAYS / 寻根路径</span><h2>从公共资料，<br />继续往根里走。</h2></div><div class="pathway-list"><p>从这些公共收藏开始，逐步拼回家族迁徙与落地的路径。</p><ul>{resources.map((resource) => <li><a href={resource.href} target="_blank" rel="noreferrer">{resource.zh}<span aria-hidden="true">↗</span></a></li>)}</ul></div></section>
</SiteLayout>
