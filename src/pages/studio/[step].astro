---
import StudioFrame from '../../components/StudioFrame.astro';
import LineageCanvas from '../../components/studio/LineageCanvas.astro';
import MediaPicker from '../../components/studio/MediaPicker.astro';
import { studioSteps, type StudioStep } from '../../data/studio';

export function getStaticPaths() {
  return studioSteps.map((step) => ({ params: { step: step.slug }, props: { step } }));
}
const { step } = Astro.props as { step: StudioStep };
const stepIndex = studioSteps.findIndex((item) => item.method === step.method);
const previousStep = stepIndex > 0 ? studioSteps[stepIndex - 1] : null;
const nextStep = stepIndex >= 0 && stepIndex < studioSteps.length - 1 ? studioSteps[stepIndex + 1] : null;
---
<StudioFrame title={`${step.method}. ${step.title}`}>
  <section class="studio-card studio-step" data-studio-step={step.method} data-step-type={step.type}>
    <div class="studio-step-intro"><span class="eyebrow">{step.english}</span><p>{step.guidance}</p></div>
    {step.type === 'cover' && <><MediaPicker method={step.method} label="封面照片" hint="先上传一张能代表这本家谱的家庭照片、地点或物件。" multiple={false} /><form data-section-form><div class="studio-fields"><label>相册家谱书名 <small>必填</small><input name="title" required placeholder="例如：黄氏相册家谱" /></label><label>第一代开族始祖 <small>必填</small><input name="ancestor" required placeholder="最早在新加坡落地生根的祖先" /></label><label>方言群 <input name="dialect" placeholder="例如：海南、福建、潮州" /></label><label>祖籍地 <input name="ancestralPlace" placeholder="例如：中国海南文昌" /></label></div><label>献词或引言 <textarea name="dedication" rows="5" placeholder="写给谁、为什么要留下这本书？"></textarea></label><label class="studio-consent"><input name="consent" type="checkbox" required /> 我确认已取得填写亲属资料所需的同意。</label><button class="button" type="submit">保存封面</button></form></>}
    {step.type === 'notes' && <><MediaPicker method={step.method} label="本章图片" hint="先上传与这一章有关的老照片、地点、物件或手稿。" /><form data-section-form data-structured-method={step.method}><div data-structured-fields></div><label class="studio-consent"><input name="complete" type="checkbox" /> 这一章暂时完成</label><button class="button" type="submit">保存这一章</button></form></>}
    {step.type === 'people' && <div data-people-section><MediaPicker method={step.method} label="世系图片" hint="先上传家族合照、人物照片或世系草图，再补充人物关系。" /><form class="studio-person-form" data-person-form><div class="studio-fields"><label>姓名 <small>必填</small><input name="name" required /></label><label>世代 <small>必填；可按父母关系调整</small><input name="generation" type="number" min="1" required /></label><label>性别 <select name="sex"><option value="unspecified">不注明</option><option value="female">女</option><option value="male">男</option></select></label><label>状态 <select name="lifeStatus"><option value="unspecified">不注明</option><option value="living">在世</option><option value="deceased">已故</option></select></label><label>出生年份 <input name="birthYear" type="number" min="1800" max="2200" /></label></div><label>人物小记 <textarea name="note" rows="4" placeholder="可写一件记得的事、称呼或照片线索。"></textarea></label><button class="button" type="submit">加入世系</button></form><div class="studio-person-list" data-person-list aria-busy="true"><p class="studio-empty">正在读取已保存的族人资料…</p></div><LineageCanvas /></div>}
    {step.type === 'register' && <div data-register-section><MediaPicker method={step.method} label="族人资料图片" hint="先上传人物照片、资料卡、旧信件或相关文档。" /><p class="studio-note">这里补充的是第 5 章已加入的人。电话和地址不会出现在公共网站。</p><div class="studio-person-list" data-register-list aria-busy="true"><p class="studio-empty">正在读取已保存的族人资料…</p></div></div>}
    <nav class="studio-chapter-nav" aria-label="章节导航">
      {previousStep ? <a class="studio-chapter-nav-link" href={`/studio/${previousStep.slug}`}>← 上一章：{previousStep.title}</a> : <a class="studio-chapter-nav-link" href="/studio">← 章节总览</a>}
      <a class="studio-chapter-preview" href={`/studio/preview?chapter=${step.method}`}>预览本章 ↗</a>
      {nextStep ? <a class="studio-chapter-nav-link studio-chapter-nav-next" href={`/studio/${nextStep.slug}`}>下一章：{nextStep.title} →</a> : <a class="studio-chapter-nav-link studio-chapter-nav-next" href="/studio/preview">查看整本预览 →</a>}
    </nav>
    <p class="studio-status" aria-live="polite" data-studio-status></p>
  </section>
</StudioFrame>
<script>
  import '../../scripts/studio-step';
</script>
