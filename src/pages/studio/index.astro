---
import StudioFrame from '../../components/StudioFrame.astro';
import { studioSteps } from '../../data/studio';
---
<StudioFrame title="我的相册家谱">
  <section class="studio-card" data-studio-dashboard>
    <div class="studio-welcome"><div><span class="eyebrow">PRIVATE BY DEFAULT / 默认私密</span><h2 data-studio-book-title>正在读取你的家谱…</h2><p data-studio-member-name></p></div><a class="text-link" href="/studio/1-cover">从封面开始 <span>↗</span></a></div>
    <div class="studio-password" data-password-change hidden><strong>先改初始密码</strong><p>为保护家人资料，请设置一个至少 12 个字符的新密码。</p><form data-password-form><label>新密码 <input name="password" type="password" minlength="12" autocomplete="new-password" required /></label><button class="button" type="submit">保存新密码</button></form></div>
    <ol class="studio-progress" data-studio-progress>
      {studioSteps.map((step) => <li data-method={step.method}><a href={`/studio/${step.slug}`}><span>{String(step.method).padStart(2, '0')}</span><strong>{step.title}</strong><small>{step.english}</small><em>未开始</em></a></li>)}
    </ol>
    <p class="studio-status" aria-live="polite" data-studio-status></p>
  </section>
</StudioFrame>
<script>
  import '../../scripts/studio-dashboard';
</script>
