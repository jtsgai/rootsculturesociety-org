---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HomeHeroMedia from '../../components/HomeHeroMedia.astro';

const featurePoints = [
  { number: '01', title: 'Singapore generation count', text: 'Do not mix generations with a China-origin register.' },
  { number: '02', title: 'Eight Methods', text: 'Cover, surname, migration, ancestral culture, lineage, childhood, family dishes, family register.' },
  { number: '03', title: 'A living book', text: 'Saved in the members’ studio and revised every five to seven years. Printing is a separate service.' },
];
---
<SiteLayout lang="en" title="Home" description="Roots Culture Society of Singapore">
  <section class="home-hero"><HomeHeroMedia /><div class="hero-copy"><div class="eyebrow">A Singapore register, written by Singaporeans.</div><h1><span class="hero-title-line">Our source may lie</span><br /><span class="hero-title-line"><em>in an ancestral place.</em></span></h1><p>Our roots are here. The Society teaches a plain, searchable Photo Genealogy: begin with the first generation that settled in Singapore, and write the founding history of your own family.</p><div class="hero-actions"><a class="button" href="/en/membership">Membership details</a><a class="text-link" href="/en/method">Meet the Eight Methods <span>↗</span></a></div></div></section>
  <section class="home-section"><div class="section-heading"><span class="eyebrow">THREE STARTING POINTS</span><h2>A living book<br />begins here.</h2></div><div class="feature-grid">{featurePoints.map((point) => <article class="feature-card"><span class="method-number">{point.number}</span><h3>{point.title}</h3><p>{point.text}</p></article>)}</div></section>
  <section class="home-section publication-feature"><div class="section-heading"><span class="eyebrow">PUBLICATIONS / 出版</span><h2>Keep the memory.<br />Pass on the path.</h2></div><div class="publication-stack"><div><img class="home-cover" src="/publications/chuan-deng-2025-optimized.jpg" alt="Chuan Deng book cover" /><span class="year">2025</span><h3>Chuan Deng</h3><p>With Singapore Hainan Hwee Kuan and Kheng Chiu Tin Hou Kong.</p></div><div><img class="home-cover" src="/publications/photo-genealogy-2026-optimized.jpg" alt="Photo Genealogy book cover" /><span class="year">2026</span><h3>Photo Genealogy</h3><p>Published by the Society.</p></div></div></section>
  <section class="home-band pathways"><div><span class="eyebrow">ROOTS PATHWAYS / 寻根路径</span><h2>Continue the search<br />through public collections.</h2></div><div><p>NHB Roots · National Archives · National Library · Singapore Chinese Cultural Centre · SFCCA</p><a class="text-link" href="/en/links">Open the pathways <span>↗</span></a></div></section>
</SiteLayout>
