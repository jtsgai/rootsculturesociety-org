---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HomeHeroMedia from '../../components/HomeHeroMedia.astro';
import HomeHeroAudio from '../../components/HomeHeroAudio.astro';
import { publications, resources } from '../../data/site';

const featurePoints = [
  { number: '01', title: 'Singapore generation count', text: 'Do not mix generations with a China-origin register.' },
  { number: '02', title: 'Eight Methods', text: 'Cover, surname, migration, ancestral culture, lineage, childhood, family dishes, family register.' },
  { number: '03', title: 'A living book', text: 'Saved in the members’ studio and revised every five to seven years. Printing is a separate service.' },
];
---
<SiteLayout lang="en" title="Home" description="Roots Culture Society of Singapore">
  <section class="home-hero"><HomeHeroMedia /><div class="hero-copy"><div class="eyebrow">A Singapore register, written by Singaporeans.</div><h1><span class="hero-title-line">The source is ancestral;</span><br /><span class="hero-title-line"><em>the roots are in Singapore.</em></span></h1><p>Our roots are here. The Society teaches a plain, searchable Photo Genealogy:<br />begin with the first generation that settled in Singapore, and write the founding history of your own family.</p><div class="hero-actions"><a class="button" href="/en/membership">Membership details</a><a class="text-link" href="/en/method">Meet the Eight Methods <span>↗</span></a></div></div><HomeHeroAudio lang="en" /><a class="hero-scroll-cue" href="#home-next" aria-label="Scroll down"><span class="hero-scroll-line"></span><span>Scroll down</span><span class="hero-scroll-arrow" aria-hidden="true">↓</span></a></section>
  <section id="home-next" class="home-section"><div class="section-heading"><span class="eyebrow">THREE STARTING POINTS</span><h2>A living book<br />begins here.</h2></div><div class="feature-grid">{featurePoints.map((point) => <article class="feature-card"><span class="method-number">{point.number}</span><h3>{point.title}</h3><p>{point.text}</p></article>)}</div></section>
  <section class="home-section publication-feature"><div class="section-heading"><span class="eyebrow">PUBLICATIONS / 出版</span><h2><span class="publication-title-line">Keep the memory.</span><span class="publication-title-line">Pass on the path.</span></h2></div><div class="publication-stack">{publications.map((publication) => <article class="publication-card"><img class="home-cover" src={publication.image} alt={publication.altEn} /><div class="publication-caption"><p class="publication-year-line">{publication.year} publication</p><p class="publication-detail-line"><strong>{publication.titleEn}</strong>: {publication.descriptionEn}</p></div></article>)}</div></section>
  <section class="home-band pathways"><div class="pathway-copy"><span class="eyebrow">ROOTS PATHWAYS / 寻根路径</span><h2>Continue the search<br />through public collections.</h2></div><div class="pathway-list"><p>Begin with these public collections, then trace the routes that brought families here.</p><ul>{resources.map((resource) => <li><a href={resource.href} target="_blank" rel="noreferrer">{resource.label}<span aria-hidden="true">↗</span></a></li>)}</ul></div></section>
</SiteLayout>
